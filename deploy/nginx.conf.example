# 奇喵宇宙维基 - Nginx 反向代理示例
# 放入 /etc/nginx/sites-available/qimiaoyuzhou.conf 并软链到 sites-enabled
# 启用前请把 server_name 替换为实际域名;如需 HTTPS 再加 443 server 块并签发证书。

server {
    listen 80;
    listen [::]:80;
    server_name qimiaoyuzhou.wiki www.qimiaoyuzhou.wiki;

    # 上传大小限制(图片上传,后端限制 8MB)
    client_max_body_size 10m;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
