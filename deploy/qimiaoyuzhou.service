[Unit]
Description=Qimiaoyuzhou Wiki (奇喵宇宙维基)
After=network.target

[Service]
Type=simple
# 改成实际部署用户的用户名
User=www-data
WorkingDirectory=/opt/qimiaoyuzhou.wiki
EnvironmentFile=/opt/qimiaoyuzhou.wiki/.env
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=3
# 基础安全加固
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
