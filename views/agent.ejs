<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Agent 录入 - 奇喵宇宙维基</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link rel="icon" href="/logo.png">
    <link href="/wiki-theme.css" rel="stylesheet">
    <style>
        body { font-family: sans-serif; background-color: #ffffff;
            background-image: url('/beijingban.png');
            background-size: cover;
            background-attachment: fixed;
            background-position: center;
            background-repeat: no-repeat; }
        body::before {
            content: '';
            position: fixed;
            inset: 0;
            background: rgba(255, 255, 255, 0.40);
            z-index: 0;
            pointer-events: none;
        }
        nav, main, footer { position: relative; z-index: 1; }
        body nav { background: rgba(255, 255, 255, 0.80) !important; }
        body main { background: rgba(255, 255, 255, 0.85) !important; }
        body footer { background: rgba(255, 255, 255, 0.80) !important; }
        .wiki-serif { font-family: 'Linux Libertine', 'Georgia', 'Times', serif; }
        .link-blue { color: #0645ad; text-decoration: none; }
        .link-blue:hover { text-decoration: underline; }
        .code-block {
            font-family: ui-monospace, Menlo, Consolas, monospace;
            font-size: 12px;
            line-height: 1.7;
            background: #0f172a;
            color: #e2e8f0;
            border-radius: 8px;
            padding: 1rem;
            overflow-x: auto;
            position: relative;
        }
        .copy-btn {
            position: absolute;
            top: 0.5rem;
            right: 0.5rem;
            background: rgba(255,255,255,0.12);
            color: #e2e8f0;
            border: 1px solid rgba(255,255,255,0.2);
            border-radius: 5px;
            padding: 0.2rem 0.6rem;
            font-size: 11px;
            cursor: pointer;
        }
        .copy-btn:hover { background: rgba(255,255,255,0.22); }
        .agent-section { border: 1px solid #dbe2ea; border-radius: 10px; background: rgba(255,255,255,0.7); }
        .agent-section h2 { border-bottom: 1px solid #dbe2ea; }
        textarea, input[type="text"] { font-family: ui-monospace, Menlo, Consolas, monospace; font-size: 12px; }
    </style>
</head>
<body class="text-gray-800 text-sm leading-6">

    <nav class="bg-white border-b border-gray-300 sticky top-0 z-50 h-14">
        <div class="container mx-auto px-4 h-full flex items-center justify-between">
            <div class="flex items-center gap-4">
                <button id="menu-btn" class="md:hidden text-gray-600 hover:bg-gray-100 p-2 rounded">
                    <i class="fas fa-bars text-xl"></i>
                </button>
                <a href="/" class="flex items-center gap-2 group">
                    <div class="w-10 h-10 rounded-full border border-gray-300 overflow-hidden">
                        <img src="/logo.png" alt="奇喵宇宙" class="w-full h-full object-cover">
                    </div>
                    <div class="flex flex-col">
                        <span class="wiki-serif text-lg font-bold leading-none mt-1">奇喵宇宙维基</span>
                        <span class="text-xs text-gray-500">奇喵圈的百科全书</span>
                    </div>
                </a>
            </div>
            <div class="flex items-center gap-3 text-xs sm:text-sm">
                <a href="/agent" class="link-blue hidden sm:inline">Agent 录入</a>
                <a href="#" class="link-blue hidden sm:inline" onclick="contactWebmaster(event)">联系站长</a>
            </div>
        </div>
    </nav>

    <div class="container mx-auto px-4 py-4 max-w-4xl">
        <main class="bg-white border border-gray-300 p-4 md:p-8 shadow-sm">
            <h1 class="wiki-serif text-2xl border-b border-gray-300 pb-2 mb-4">通过 Agent 批量录入条目</h1>

            <p class="text-gray-600 mb-6">
                此页面面向会使用 AI Agent(如 Claude)的贡献者:把原始资料交给 Agent,按下方提示词整理成
                维基条目格式,再通过 API 批量上传。你只需要准备资料,格式化和上传由 Agent 完成。
            </p>

            <!-- 提示词 -->
            <section class="agent-section p-4 mb-6">
                <h2 class="font-bold text-lg mb-2"><i class="fas fa-comment-dots text-blue-500 mr-2"></i>1. 给 Agent 的提示词</h2>
                <p class="text-xs text-gray-500 mb-2">复制下面的提示词,连同你的原始资料一起发给 Agent。</p>
                <div class="code-block">
                    <button class="copy-btn" onclick="copyCode(this)">复制</button>
                    你是奇喵宇宙维基的资料整理员。请把用户提供的原始资料整理成维基条目,并输出 JSON。

## 要求
1. 每条资料生成一个条目对象,格式:
   {"title": "条目标题", "content": "Markdown 正文", "summary": "一句话摘要", "author": "你的署名(可空)"}
2. content 使用 Markdown:
   - 用 # 作一级标题(可省略,系统会自动加标题)
   - 用 ## 分章节(如 ## 内容简介、## 角色介绍)
   - 列表用 - 或 1.
   - 表格用 | 列 | 列 |
   - 需要信息栏时,输出 HTML(见下方模板),放正文开头
3. 信息栏模板(可选):
   <table class="infobox"><tr><th colspan="2" class="infobox-title">标题</th></tr>
   <tr><th scope="row">字段名</th><td>内容</td></tr></table>
4. summary 一句话概括条目,供首页展示。

## 输出
只输出一个 JSON 数组,不要输出其他文字:
[
  {"title": "...", "content": "...", "summary": "...", "author": "..."}
]

## 资料
[在此粘贴你的原始资料]
                </div>
            </section>

            <!-- API 地址 -->
            <section class="agent-section p-4 mb-6">
                <h2 class="font-bold text-lg mb-2"><i class="fas fa-server text-green-500 mr-2"></i>2. API 地址</h2>
                <table class="w-full text-sm mb-2">
                    <tr class="border-b border-gray-200">
                        <td class="py-2 pr-4 font-bold">批量新建条目</td>
                        <td class="py-2"><code class="bg-gray-100 px-2 py-0.5 rounded">POST <%= apiBase %>/api/pages/batch</code></td>
                    </tr>
                    <tr class="border-b border-gray-200">
                        <td class="py-2 pr-4 font-bold">单个新建条目</td>
                        <td class="py-2"><code class="bg-gray-100 px-2 py-0.5 rounded">POST <%= apiBase %>/api/pages</code></td>
                    </tr>
                    <tr class="border-b border-gray-200">
                        <td class="py-2 pr-4 font-bold">获取现有条目</td>
                        <td class="py-2"><code class="bg-gray-100 px-2 py-0.5 rounded">GET <%= apiBase %>/api/pages</code></td>
                    </tr>
                    <tr>
                        <td class="py-2 pr-4 font-bold">请求格式</td>
                        <td class="py-2">JSON,<code class="bg-gray-100 px-2 py-0.5 rounded">Content-Type: application/json</code></td>
                    </tr>
                </table>
                <p class="text-xs text-gray-500">批量接口请求体为条目数组;单条接口请求体为单个条目对象。</p>
            </section>

            <!-- 使用方法 -->
            <section class="agent-section p-4 mb-6">
                <h2 class="font-bold text-lg mb-2"><i class="fas fa-book text-purple-500 mr-2"></i>3. 使用方法</h2>
                <ol class="list-decimal list-inside space-y-2 text-sm text-gray-700 mb-3">
                    <li>把原始资料和上方提示词一起发给 Agent。</li>
                    <li>Agent 整理后输出一个 JSON 数组(每条含 title/content/summary/author)。</li>
                    <li>在下方「快速测试」粘贴该 JSON,点「提交上传」;或用 curl 直接调用。</li>
                    <li>上传成功后刷新首页,新条目即出现。</li>
                </ol>
                <p class="text-xs text-gray-500 mb-2">curl 示例(在服务器或本机执行):</p>
                <div class="code-block">
                    <button class="copy-btn" onclick="copyCode(this)">复制</button>
curl -X POST "<%= apiBase %>/api/pages/batch" \
  -H "Content-Type: application/json" \
  -d '[{"title":"测试条目","content":"## 简介\n这是正文。","summary":"一句话摘要","author":"站长"}]'
                </div>
            </section>

            <!-- 快速测试 -->
            <section class="agent-section p-4">
                <h2 class="font-bold text-lg mb-2"><i class="fas fa-flask text-yellow-500 mr-2"></i>4. 快速测试</h2>
                <p class="text-xs text-gray-500 mb-2">粘贴 Agent 输出的 JSON 数组,点「提交上传」即可写入服务器(会真实创建条目)。</p>
                <textarea id="json-input" rows="10" class="w-full border border-gray-300 rounded p-3 mb-2 focus:outline-none focus:border-blue-400"
                          placeholder='[{"title":"示例条目","content":"## 简介\n\n示例正文。","summary":"示例","author":"站长"}]'></textarea>
                <div class="flex items-center gap-3 mb-2">
                    <button type="button" id="submit-btn" class="bg-blue-600 hover:bg-blue-700 text-white font-bold px-5 py-2 rounded">提交上传</button>
                    <span id="result" class="text-xs"></span>
                </div>
                <div id="result-detail" class="hidden mt-2 p-3 bg-gray-50 border border-gray-200 rounded text-xs"></div>
            </section>
        </main>
    </div>

    <footer class="pt-8 pb-40 bg-white border-t border-gray-300 text-xs text-gray-600">
        <div class="container mx-auto px-4 text-center">
            <p>奇喵宇宙维基 · Agent 批量录入</p>
        </div>
    </footer>

    <script>
        function copyCode(btn) {
            const block = btn.parentElement;
            const text = block.innerText.replace(/^复制\s*/, '').trim();
            navigator.clipboard.writeText(text).then(() => {
                btn.textContent = '已复制!';
                setTimeout(() => { btn.textContent = '复制'; }, 1500);
            });
        }

        document.getElementById('submit-btn').addEventListener('click', async function () {
            const resultEl = document.getElementById('result');
            const detailEl = document.getElementById('result-detail');
            let items;
            try {
                items = JSON.parse(document.getElementById('json-input').value);
            } catch (e) {
                resultEl.textContent = 'JSON 格式错误:' + e.message;
                resultEl.className = 'text-xs text-red-600';
                return;
            }
            if (!Array.isArray(items)) {
                resultEl.textContent = '需要 JSON 数组';
                resultEl.className = 'text-xs text-red-600';
                return;
            }
            resultEl.textContent = '上传中...';
            resultEl.className = 'text-xs text-blue-600';
            try {
                const res = await fetch('/api/pages/batch', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(items)
                });
                const data = await res.json();
                if (!res.ok) throw new Error(data.error || '上传失败');
                resultEl.textContent = '成功 ' + data.ok + ' 条,失败 ' + data.failed + ' 条';
                resultEl.className = 'text-xs ' + (data.failed ? 'text-yellow-600' : 'text-green-600');
                detailEl.classList.remove('hidden');
                detailEl.textContent = JSON.stringify(data.results, null, 2);
            } catch (err) {
                resultEl.textContent = '上传失败:' + err.message;
                resultEl.className = 'text-xs text-red-600';
            }
        });

        function contactWebmaster(e) {
            e.preventDefault();
            window.prompt('站长邮箱:', 'wuzhidizhemaotianchen@gmail.com');
        }
    </script>
</body>
</html>
