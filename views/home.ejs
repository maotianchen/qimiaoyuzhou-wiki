<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>奇喵宇宙维基 - 首页</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link rel="icon" href="/logo.png">
    <style>
        body {
            font-family: sans-serif;
            background-color: #ffffff;
            background-image: url('/beijingban.png');
            background-size: cover;
            background-attachment: fixed;
            background-position: center;
            background-repeat: no-repeat;
        }
        /* 白色半透明遮罩 */
        body::before {
            content: '';
            position: fixed;
            inset: 0;
            background: rgba(255, 255, 255, 0.40);
            z-index: 0;
            pointer-events: none;
        }
        nav, #sidebar, main, footer {
            position: relative;
            z-index: 1;
        }
        /* 上层容器半透明,露出背景(用高特异性覆盖 Tailwind 的 bg-white) */
        body nav {
            background: rgba(255, 255, 255, 0.80) !important;
        }
        body main {
            background: rgba(255, 255, 255, 0.85) !important;
        }
        body footer {
            background: rgba(255, 255, 255, 0.80) !important;
        }
        body main .wiki-box {
            background-color: rgba(255, 255, 255, 0.75) !important;
        }
        #sidebar .wiki-box, .wiki-box {
            background-color: rgba(255, 255, 255, 0.80);
        }
        .bg-gray-50 {
            background-color: rgba(255, 255, 255, 0.55);
        }
        .wiki-serif {
            font-family: 'Linux Libertine', 'Georgia', 'Times', serif;
        }
        .wiki-border {
            border: 1px solid #a7d7f9;
        }
        .wiki-bg-header {
            background-color: #cedff2;
            background-image: linear-gradient(to bottom, #f5faff 0%, #cedff2 100%);
        }
        .wiki-box {
            border: 1px solid #a2a9b1;
            background-color: #fff;
        }
        .wiki-box-header {
            background-color: #f8f9fa;
            border-bottom: 1px solid #a2a9b1;
            padding: 0.5rem 1rem;
            font-weight: bold;
            display: flex;
            align-items: center;
        }
        .link-blue {
            color: #3366cc;
            text-decoration: none;
        }
        .link-blue:hover {
            text-decoration: underline;
        }
        .link-red {
            color: #ba0000;
        }
        #mobile-sidebar {
            transition: transform 0.3s ease-in-out;
        }
    </style>
    <link href="/wiki-theme.css" rel="stylesheet">
</head>
<body class="text-gray-800 text-sm leading-6">

    <!-- Top Navigation Bar -->
    <nav class="bg-white border-b border-gray-300 sticky top-0 z-50 h-14">
        <div class="container mx-auto px-4 h-full flex items-center justify-between">

            <div class="flex items-center gap-4">
                <button id="menu-btn" class="md:hidden text-gray-600 hover:bg-gray-100 p-2 rounded">
                    <i class="fas fa-bars text-xl"></i>
                </button>
                <a href="/" class="flex items-center gap-2 group">
                    <div class="w-10 h-10 rounded-full border border-gray-300 overflow-hidden">
                        <img src="/logo.png" alt="奇喵宇宙" class="w-full h-full object-cover">
                    </div>
                    <div class="flex flex-col">
                        <span class="wiki-serif text-lg font-bold leading-none mt-1">奇喵宇宙维基</span>
                        <span class="text-xs text-gray-500">奇喵圈的百科全书</span>
                    </div>
                </a>
            </div>

            <!-- Search Form -->
            <form class="hidden sm:flex flex-1 max-w-lg mx-4" action="/search" method="get">
                <div class="relative w-full">
                    <input type="text" name="q" placeholder="搜索" class="w-full border border-gray-300 rounded px-3 py-1.5 focus:outline-none focus:border-blue-400 focus:ring-1 focus:ring-blue-400 transition-colors">
                    <button type="submit" class="absolute right-0 top-0 h-full px-3 text-gray-500 hover:text-gray-700">
                        <i class="fas fa-search"></i>
                    </button>
                </div>
            </form>

            <div class="flex items-center gap-3 text-xs sm:text-sm">
                <a href="#" class="link-blue hidden sm:inline" onclick="contactWebmaster(event)">联系站长</a>
                <button class="text-gray-600 hover:bg-gray-100 p-2 rounded sm:hidden">
                    <i class="fas fa-search"></i>
                </button>
                <button class="text-gray-600 hover:bg-gray-100 p-2 rounded sm:hidden">
                    <i class="fas fa-user"></i>
                </button>
            </div>
        </div>
    </nav>

    <!-- Main Container -->
    <div class="container mx-auto px-0 md:px-4 py-4 flex flex-col md:flex-row gap-6 relative">

        <!-- Sidebar -->
        <aside id="sidebar" class="hidden md:block w-44 flex-shrink-0 space-y-6 text-xs">
            <div class="bg-gray-50 p-2 rounded border border-gray-200 md:border-0 md:bg-transparent md:p-0">
                <h3 class="font-bold text-gray-500 border-b border-gray-200 pb-1 mb-2">全站导航</h3>
                <ul class="space-y-1.5">
                    <li><a href="/" class="link-blue">首页</a></li>
                    <li><a href="/recent" class="link-blue">最近更改</a></li>
                    <li><a href="/random" class="link-blue">随机条目</a></li>
                </ul>
            </div>
            <div>
                <h3 class="font-bold text-gray-500 border-b border-gray-200 pb-1 mb-2">工具</h3>
                <ul class="space-y-1.5">
                    <li><a href="/wiki/%E6%96%B0%E5%BB%BA%E9%A1%B5%E9%9D%A2/edit" class="link-blue">添加页面</a></li>
                    <li><a href="/recent" class="link-blue">最近更改</a></li>
                </ul>
            </div>
        </aside>

        <!-- Mobile Sidebar -->
        <div id="mobile-overlay" class="fixed inset-0 bg-black bg-opacity-50 z-40 hidden md:hidden" onclick="toggleMobileMenu()"></div>
        <div id="mobile-sidebar" class="fixed inset-y-0 left-0 w-64 bg-white z-50 transform -translate-x-full md:hidden overflow-y-auto p-4 shadow-lg">
            <div class="flex justify-between items-center mb-4">
                <span class="font-bold text-lg wiki-serif">导航</span>
                <button onclick="toggleMobileMenu()" class="text-gray-500"><i class="fas fa-times"></i></button>
            </div>
            <ul class="space-y-4 text-sm">
                <li><a href="/" class="block p-2 bg-gray-100 rounded">首页</a></li>
                <li><a href="/random" class="block p-2 hover:bg-gray-50">随机条目</a></li>
                <li><a href="/recent" class="block p-2 hover:bg-gray-50">最近更改</a></li>
            </ul>
        </div>

        <!-- Main Content -->
        <main class="flex-1 min-w-0 bg-white md:border md:border-gray-300 p-0 md:p-6 shadow-sm">

            <!-- Welcome Banner -->
            <div class="welcome-banner bg-green-50 border border-green-200 p-4 mb-6 text-center rounded-sm">
                <h1 class="wiki-serif text-2xl md:text-3xl mb-1">欢迎来到奇喵宇宙</h1>
                <div class="text-sm text-gray-500">
                    人人可编辑的自由百科全书<br>
                    现有 <span class="font-bold text-black"><%= pageCount %></span> 篇条目
                </div>
            </div>

            <!-- Top Grid -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 mb-4">

                <!-- Featured Article -->
                <div class="wiki-box rounded-sm flex flex-col h-full">
                    <div class="wiki-box-header bg-blue-50 border-blue-200">
                        <i class="fas fa-star text-yellow-500 mr-2"></i> 特色条目
                    </div>
                    <% if (featured) { %>
                    <div class="p-4 flex flex-col md:flex-row gap-4 h-full">
                        <div class="flex-1">
                            <h2 class="font-bold text-lg mb-2">
                                <a href="/wiki/<%= encodeURIComponent(featured.title) %>" class="link-blue"><%= featured.title %></a>
                            </h2>
                            <p class="text-justify mb-2"><%= featured.summary %></p>
                            <div class="text-right mt-auto">
                                <a href="/wiki/<%= encodeURIComponent(featured.title) %>" class="link-blue text-xs font-bold">(阅读全文...)</a>
                            </div>
                        </div>
                    </div>
                    <% } else { %>
                    <div class="p-4 text-gray-400">暂无特色条目</div>
                    <% } %>
                </div>

                <!-- Recent Changes -->
                <div class="wiki-box rounded-sm flex flex-col h-full">
                    <div class="wiki-box-header bg-blue-50 border-blue-200">
                        <i class="fas fa-newspaper text-blue-500 mr-2"></i> 最近更改
                    </div>
                    <div class="p-4 flex flex-col h-full">
                        <ul class="list-disc list-inside space-y-2 flex-1">
                            <% recent.forEach(function(e) { %>
                            <li>
                                <a href="/wiki/<%= encodeURIComponent(e.title) %>" class="link-blue font-bold"><%= e.title %></a>
                                <% if (e.summary) { %> <span class="text-gray-500">(<%= e.summary %>)</span> <% } %>
                                <% if (e.author) { %> <span class="text-gray-400 text-xs">by <%= e.author %></span> <% } %>
                            </li>
                            <% }) %>
                            <% if (!recent.length) { %>
                            <li class="text-gray-400">还没有任何编辑记录</li>
                            <% } %>
                        </ul>
                        <div class="mt-auto text-right border-t pt-2 text-xs">
                            <a href="/recent" class="link-blue mr-2">更多...</a>
                        </div>
                    </div>
                </div>
            </div>

        </main>
    </div>

    <!-- Footer -->
    <footer class="pt-8 pb-40 bg-white border-t border-gray-300 text-xs text-gray-600">
        <div class="container mx-auto px-4 text-center">
            <p class="mb-4">
                本站的全部文字在<a href="#" class="link-blue">知识共享 署名-相同方式共享 4.0协议</a>之条款下提供,附加条款亦可能应用。<br>
                奇喵宇宙®和奇喵宇宙标志是<a href="#" class="link-blue">湖南崇鳞网络科技有限公司</a>的注册商标;奇喵君故事™是商标。<br>
                奇喵宇宙维基基金会是按棍母税收法501(c)(3)登记的<a href="#" class="link-blue">非营利慈善机构</a>。
            </p>
            <div class="flex flex-wrap justify-center gap-4">
                <a href="#" class="link-blue">隐私政策</a>
                <a href="#" class="link-blue">关于奇喵宇宙维基百科</a>
                <a href="#" class="link-blue">免责声明</a>
                <a href="#" class="link-blue">联系我们</a>
                <a href="#" class="link-blue">开发者</a>
                <a href="#" class="link-blue">统计</a>
                <a href="#" class="link-blue">Cookie声明</a>
            </div>
        </div>
    </footer>

    <script>
        const menuBtn = document.getElementById('menu-btn');
        const mobileSidebar = document.getElementById('mobile-sidebar');
        const overlay = document.getElementById('mobile-overlay');

        function toggleMobileMenu() {
            const isHidden = mobileSidebar.classList.contains('-translate-x-full');
            if (isHidden) {
                mobileSidebar.classList.remove('-translate-x-full');
                overlay.classList.remove('hidden');
            } else {
                mobileSidebar.classList.add('-translate-x-full');
                overlay.classList.add('hidden');
            }
        }
        menuBtn.addEventListener('click', toggleMobileMenu);

        // 联系站长:弹出邮箱
        function contactWebmaster(e) {
            e.preventDefault();
            window.prompt('站长邮箱:', 'wuzhidizhemaotianchen@gmail.com');
        }
    </script>
</body>
</html>
