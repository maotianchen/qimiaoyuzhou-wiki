<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>页面不存在 - 奇喵宇宙维基</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="icon" href="/logo.png">
    <style>
        body { font-family: sans-serif; background-color: #ffffff;
            background-image: url('/beijingban.png');
            background-size: cover;
            background-attachment: fixed;
            background-position: center;
            background-repeat: no-repeat; }
        body::before {
            content: '';
            position: fixed;
            inset: 0;
            background: rgba(255, 255, 255, 0.40);
            z-index: 0;
            pointer-events: none;
        }
        nav, .container, footer {
            position: relative;
            z-index: 1;
        }
        body nav { background: rgba(255, 255, 255, 0.80) !important; }
        body footer { background: rgba(255, 255, 255, 0.80) !important; }
            /* 白底延展到页面最底部,避免底部露出背景色空隙 */
                    .wiki-serif { font-family: 'Linux Libertine', 'Georgia', 'Times', serif; }
        .link-blue { color: #0645ad; text-decoration: none; }
        .link-blue:hover { text-decoration: underline; }
    </style>
    <link href="/wiki-theme.css" rel="stylesheet">
</head>
<body class="text-gray-800 text-sm leading-6">

    <nav class="bg-white border-b border-gray-300 sticky top-0 z-50 h-14">
        <div class="container mx-auto px-4 h-full flex items-center">
            <a href="/" class="flex items-center gap-2 group">
                <div class="w-10 h-10 rounded-full border border-gray-300 overflow-hidden">
                    <img src="/logo.png" alt="奇喵宇宙" class="w-full h-full object-cover">
                </div>
                <span class="wiki-serif text-lg font-bold leading-none">奇喵宇宙维基</span>
            </a>
        </div>
    </nav>

    <div class="container mx-auto px-4 py-16 max-w-2xl text-center">
        <h1 class="wiki-serif text-3xl mb-4">页面不存在</h1>
        <% if (title) { %>
        <p class="mb-4 text-gray-600">「<%= title %>」条目还没有创建。</p>
        <a href="/wiki/<%= encodeURIComponent(title) %>/edit" class="link-blue font-bold">点击创建此页面</a>
        <% } else { %>
        <p class="text-gray-600">您访问的页面不存在。</p>
        <% } %>
        <div class="mt-6">
            <a href="/" class="link-blue">返回首页</a>
        </div>
    </div>

    <footer class="pt-8 pb-40 bg-white border-t border-gray-300 text-xs text-gray-600">
        <div class="container mx-auto px-4 text-center">
            <p>奇喵宇宙维基</p>
        </div>
    </footer>
</body>
</html>
